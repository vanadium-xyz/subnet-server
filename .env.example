# Steward identity — the ETH-keyed admin. Signs subnet messages and owns the
# Matrix rooms. Its Matrix account is @{address}:{MATRIX_SERVER_NAME}.
ETH_PRIVATE_KEY=

# Used only to derive SIGN_MESSAGE (`{domain}-matrix-auth`); clients must sign
# the same message. Set this to the public API base, e.g. https://subnet.example.com
SUBNET_API_BASE=

DB_NAME=subnet_server
DB_HOST=localhost

API_PORT=34182

# tuwunel homeserver
MATRIX_URL=http://localhost:6167
MATRIX_SERVER_NAME=localhost
MATRIX_REGISTRATION_TOKEN=
# Admin command room used to deactivate accounts on user removal.
MATRIX_ADMIN_ROOM_ID=

# Steward display name
STEWARD_NAME=Steward

# Comma-separated rooms every new user is invited to and force-joined into.
# Created (owned by the Steward) on startup if they don't exist.
AUTO_JOIN_ROOMS=General
