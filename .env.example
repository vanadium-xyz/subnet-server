# Steward identity — the ETH-keyed admin. Signs subnet messages and owns the
# Matrix rooms. Its Matrix account is @{address}:{MATRIX_SERVER_NAME}.
ETH_PRIVATE_KEY=

# Used only to derive SIGN_MESSAGE (`{domain}-matrix-auth`); clients must sign
# the same message. Set this to the public API base, e.g. https://subnet.example.com
SUBNET_API_BASE=

DB_NAME=subnet_server
DB_HOST=localhost

API_PORT=34182

# tuwunel homeserver
MATRIX_URL=http://localhost:6167
MATRIX_SERVER_NAME=localhost
MATRIX_REGISTRATION_TOKEN=
# Admin command room used to deactivate accounts on user removal.
MATRIX_ADMIN_ROOM_ID=

# Steward display name
STEWARD_NAME=Steward

# Default subnet name, returned by /api/metadata (defaults to the domain). The
# operator can override the name and set the icon at runtime from the local-only
# /admin page, or with:
#   curl -F name="My Subnet" -F file=@logo.png http://localhost:34182/api/set_branding
SUBNET_NAME=
# Where the uploaded subnet icon + name override are stored (defaults to ./icon).
ICON_DIR=

# Comma-separated rooms every new user is invited to. The Steward creates them
# via the `subnet` CLI (owned by the admin agent) the first time a user is
# added if they don't already exist. Users accept the invites with their own
# client — they are not force-joined.
AUTO_JOIN_ROOMS=General
